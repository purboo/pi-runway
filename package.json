{
  "name": "pi-runway",
  "version": "0.2.4",
  "description": "The editor frame tells you everything: where you are, the model, a context runway, and whose turn it is. Zero config, fast.",
  "type": "module",
  "license": "MIT",
  "author": "purboo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purboo/pi-runway.git"
  },
  "homepage": "https://github.com/purboo/pi-runway#readme",
  "bugs": {
    "url": "https://github.com/purboo/pi-runway/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "footer",
    "statusline",
    "editor",
    "context"
  ],
  "files": [
    "index.ts",
    "src"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/purboo/pi-runway/main/design/preview.png"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && bun test",
    "link-pi": "D=\"$(dirname \"$(readlink -f \"$(command -v pi)\")\")/../../..\" && mkdir -p node_modules/@earendil-works && for p in pi-ai pi-coding-agent pi-tui; do ln -sfn \"$(cd \"$D/$p\" && pwd)\" node_modules/@earendil-works/$p; done"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "5"
  }
}
